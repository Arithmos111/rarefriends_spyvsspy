# Copy to .env and fill in. Never commit .env.

# The hostname players will visit. Its DNS A record must already point at this machine,
# or Caddy cannot obtain a certificate.
DOMAIN=agency.example.com

# Optional. The Genesis perk (one extra letter bomb and a badge) is on by default, using the
# Rare Friends Genesis address carried in server/rpc.mjs. Set this to override that address,
# or to an empty value to switch the perk off. Play is gated on Generations either way.
# RF_GENESIS_ADDRESS=
