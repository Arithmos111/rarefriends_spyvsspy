# Copy to .env and fill in. Never commit .env.

# The hostname players will visit. Its DNS A record must already point at this machine,
# or Caddy cannot obtain a certificate.
DOMAIN=embassy.example.com

# Optional. The Rare Friends Genesis contract address, which switches on the Genesis perk
# (one extra letter bomb and a badge). FriendSDK v0.1 does not publish this address, so
# leave it unset until you have it. Play is gated on Generations either way.
RF_GENESIS_ADDRESS=
